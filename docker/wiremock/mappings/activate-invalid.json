{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/provider/v1/activate",
    "headers": {
      "Idempotency-Key": { "matches": ".+" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.productCode", "matches": "^INVALID.*" } }
    ]
  },
  "response": {
    "status": 400
  }
}
